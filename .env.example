ADMIN_PASSWORD=
ENCRYPTION_KEY=
GEMINI_API_KEY=
VITE_RECAPTCHA_SITE_KEY=

# V79Tiquet Gateway: when the Contact Us form is submitted, the lead is
# automatically created as a Client in V79Tiquet's Client Management,
# marked as a website lead. Both unset = integration simply inactive.
# Internal Docker address (both apps share the proxy_network network):
V79TIQUET_INTAKE_URL=http://v79-tiquet-manager:3050/api/public/intake
# Must match V79Tiquet's own INTAKE_SECRET env var exactly.
V79TIQUET_INTAKE_SECRET=

# Server-side verification of the reCAPTCHA v3 token the contact form
# already generates client-side (via VITE_RECAPTCHA_SITE_KEY above) but
# which was previously never actually checked. Leave unset to skip
# verification entirely (not recommended once the Tiquet gateway above is
# configured, since an unverified form then also creates Tiquet clients).
RECAPTCHA_SECRET_KEY=