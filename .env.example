ADMIN_EMAIL=
# Leave blank for normal operation. The server seeds its own secure initial
# password on first run and forces a password change on first login.
ADMIN_PASSWORD=
# Locked out of the admin panel? Set this to any new value (e.g.
# `openssl rand -hex 8`, or today's date) and restart the container to force
# a one-time password reset. Optionally set ADMIN_PASSWORD above at the same
# time to choose the new password yourself; otherwise a one-time password is
# generated and printed to the container logs once. Safe to leave set
# afterwards — it will not reset again until you change its value.
ADMIN_RESET_TOKEN=
CANONICAL_DOMAIN=
ENCRYPTION_KEY=
GEMINI_API_KEY=
RECAPTCHA_SECRET_KEY=
V79TIQUET_INTAKE_SECRET=
V79TIQUET_INTAKE_URL=
VITE_RECAPTCHA_SITE_KEY=
